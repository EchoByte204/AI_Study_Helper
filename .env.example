POSTGRES_DB=rag_tutor
POSTGRES_USER=rag_tutor
POSTGRES_PASSWORD=change-me-for-shared-environments
DATABASE_URL=postgresql+psycopg://rag_tutor:change-me-for-shared-environments@localhost:5433/rag_tutor

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=256
EMBEDDING_WORKERS=3
CHAT_MODEL=gpt-4o-mini
ENABLE_QUERY_REWRITE=true

CHUNK_SIZE=1200
CHUNK_OVERLAP=180
TOP_K=5
MAX_UPLOAD_MB=25
MEDIA_DIR=media
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO

# Optional for eval/run_eval.py. Set an estimated input-token price per 1,000 tokens.
COST_PER_1K_INPUT_TOKENS=
